{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [".flue/**/*.ts", "src/**/*.ts", "test/**/*.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
