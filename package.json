{
  "name": "memory-banks-flue-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/flue-run.sh dev --target node --env .env --port ${PORT:-3583}",
    "curator": "./scripts/flue-run.sh run curator --target node --id test-1 --env .env --payload",
    "retriever": "./scripts/flue-run.sh run retriever --target node --id test-1 --env .env --payload",
    "build": "flue build --target node",
    "start": "node dist/server.mjs",
    "serve": "npm run build && PORT=47823 node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flue/sdk": "latest",
    "just-bash": "^3.0.0",
    "valibot": "latest"
  },
  "devDependencies": {
    "@flue/cli": "latest",
    "typescript": "^5.6.0"
  }
}
