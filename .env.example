OPENROUTER_API_KEY="sk-or-v1-..."

# Optional. Root directory for all memory banks.
# Defaults to ~/.bank-memory. Each bank lives in <root>/<bank-name>/.
# MEMORY_BANK_ROOT="~/.bank-memory"

# Optional. Git author identity used for autocommits inside each bank.
# Defaults to "memory-bank curator <curator@bank-memory.local>".
# GIT_AUTHOR_NAME="..."
# GIT_AUTHOR_EMAIL="..."
